# Mastrotickets PHP REST API Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.mastrotickets.hu
FRONTEND_URL=https://mastrotickets.hu

# Firebase Credentials
FIREBASE_PROJECT_ID="mastrotickets-f1"
FIREBASE_CREDENTIALS_PATH="/etc/secrets/firebase-service-account.json"

# Stripe Payments (Section 9)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="eur"

# Resend Transactional Email (Section 13)
RESEND_API_KEY="re_..."
EMAIL_FROM_ADDRESS="tickets@mastrotickets.hu"
EMAIL_SUPPORT_ADDRESS="support@mastrotickets.hu"

# Cloudinary Media (Section 14)
CLOUDINARY_CLOUD_NAME="mastrotickets"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="..."

# Inventory & Reservation Policies
RESERVATION_EXPIRY_MINUTES=10
DEFAULT_TAX_RATE=0.10
SERVICE_FEE_PERCENTAGE=0.06
