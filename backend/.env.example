# ==============================================================================
# MASTROTICKETS PHP REST API — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env on your production Hostinger VPS (never commit .env to Git)
# ==============================================================================

# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.mastrotickets.co
FRONTEND_URL=https://mastrotickets.co

# Allowed CORS Origins (comma-separated for multiple)
CORS_ALLOWED_ORIGINS=https://mastrotickets.co,https://www.mastrotickets.co,http://localhost:3000

# Relational Database Configuration (MySQL / MariaDB on Hostinger VPS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mastrotickets_db
DB_USERNAME=mastrotickets_user
DB_PASSWORD=your_secure_db_password_here
DB_CHARSET=utf8mb4

# Admin Authentication & Security
ADMIN_USERNAME=mastrotickets
# Use password_hash('mastrotickets@123', PASSWORD_BCRYPT) or custom hash
ADMIN_PASSWORD_HASH=$2y$10$wK1W5yN1qN6p4F2e2f3gO.8x8mK8N2d1e0f9a8b7c6d5e4f3a2b1c
JWT_SECRET=your_32_character_random_hex_secret_key_here
JWT_EXPIRY_HOURS=24

# Stripe Payments Integration (API & Webhooks)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
STRIPE_CURRENCY=aed

# Resend Transactional Email API
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=tickets@mastrotickets.co
EMAIL_FROM_NAME="MastroTickets Formula 1 Passes"
EMAIL_SUPPORT_ADDRESS=support@mastrotickets.co

# Cloudinary Media Storage (Ticket Vouchers & Banner Assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Ticketing & Inventory Concurrency Policies
RESERVATION_EXPIRY_MINUTES=10
DEFAULT_TAX_RATE=0.10
SERVICE_FEE_PERCENTAGE=0.06

